# Copy to .env (same folder) and fill in. Never commit .env.

# Required: the app is reachable from your devices, so it must ask for a password
JOBTRACKER_PASSWORD=

# Optional: friends (see README, "Share with friends"). Your Tailscale login, then theirs, comma-separated.
# Then only Tailscale identity counts (the password is ignored): use the https://….ts.net address, also on
# this PC. Each friend gets their
# own data in HOST_DATA_DIR/users/<their login>/. Anyone else on your Tailscale network is refused.
# JOBTRACKER_OWNER=you@example.com
# JOBTRACKER_FRIENDS=friend@example.com,other.friend@example.com

# Optional: AI features (assistant, CV import, AI matching, drafts, summary review)
OPENAI_API_KEY=

# Where your data and generated CVs live on this PC (forward slashes work on Windows)
HOST_DATA_DIR=C:/JobSearch/data
HOST_OUTPUT_DIR=C:/JobSearch/companies

# Image version: latest = follow every release published by CI
IMAGE_TAG=latest
# PORT=8000
# OPENAI_MODEL=gpt-5.4-mini
