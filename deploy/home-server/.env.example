# Copy to .env (same folder) and fill in. Never commit .env.

# Who can use the app: decided by Tailscale (your devices + people you share this PC with), each with
# their own data. No password and no user list (see README, "Share with friends").
# Rarely needed: your Tailscale login, only if it isn't the email in your master CV
# JOBTRACKER_OWNER=you@example.com

# Optional: AI features (assistant, CV import, AI matching, drafts, summary review)
OPENAI_API_KEY=
# Optional: Claude takes over when OpenAI fails on quota/billing (billed per token by Anthropic)
ANTHROPIC_API_KEY=

# Where your data and generated CVs live on this PC (forward slashes work on Windows)
HOST_DATA_DIR=C:/JobSearch/data
HOST_OUTPUT_DIR=C:/JobSearch/companies
HOST_CODEX_DIR=C:/JobSearch/codex

# Interview prep ("Prepare interview" button): who may use it, as Tailscale logins, comma-separated.
# It runs Codex signed in with YOUR ChatGPT account (see the guide, "Interview prep").
JOBTRACKER_PREMIUM=
# JOBTRACKER_PREP_MODEL=gpt-6.2-astra
# JOBTRACKER_PREP_EFFORT=high
# Scheduling a technical interview starts its prep by itself (once per application); 0 = off
# JOBTRACKER_AUTO_PREP=1

# Optional: news from each person's Gmail or Outlook (read-only) on Today. A Google OAuth client: see the guide, "Email".
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# JOBTRACKER_MAIL_EVERY_MIN=10

# Image version: latest = follow every release published by CI
IMAGE_TAG=latest
# PORT=8000
# OPENAI_MODEL=gpt-5.4-mini
