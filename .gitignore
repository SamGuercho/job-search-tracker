# --- Personal data: never commit ---------------------------------------------
# Your master CV, applications, chats, uploaded CVs and backups
data/*
!data/seed/
# Generated CVs and job descriptions (when not redirected to another folder)
output/
# Secrets (OpenAI key) and local paths
.env

# --- Local tooling -------------------------------------------------------------
.venv/
__pycache__/
*.pyc
.DS_Store
.claude/*
!.claude/skills/
# Eval cases and runs (real conversations): local only, see jobtracker/evals
evals/local/
~$*

# Home server deployment: local data, CVs, settings and logs
deploy/home-server/data/
deploy/home-server/companies/
deploy/home-server/update.log
deploy/home-server/backup.log
deploy/home-server/failed-update.log
deploy/home-server/bad-image.txt

# Codex sign-in on the home server (a ChatGPT login token: never commit it)
deploy/home-server/codex/
