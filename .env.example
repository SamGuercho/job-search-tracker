# Local settings. Copy this file to .env (run.sh does it on first launch) and edit.
# .env is git-ignored: it never leaves your computer.

# --- AI features (optional) -----------------------------------------------------
# Needed for: the Assistant tab, importing a CV file, AI keyword matching, wording drafts,
# and the CV summary check. Everything else works without it.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-mini          # used for imports, matching, drafts, reviews
# OPENAI_CHAT_MODEL=gpt-5.4-mini     # used by the Assistant (defaults to OPENAI_MODEL)

# --- Where generated files go -----------------------------------------------------
# One folder per company with the CVs and the saved job description. Default: ./output
# Example (macOS iCloud Drive):
# JOBTRACKER_OUTPUT_DIR=~/Library/Mobile Documents/com~apple~CloudDocs/Documents/Job Search/companies
# JOBTRACKER_OUTPUT_DIR=~/Documents/Job Search/companies

# File name of generated CVs, without extension ({name} = your name, {company} = the company)
# JOBTRACKER_CV_FILENAME={name}_CV

# --- PDF export ---------------------------------------------------------------------
# Auto-detected: LibreOffice first, then Microsoft Word. Force one with: libreoffice | word | none
# JOBTRACKER_PDF_ENGINE=libreoffice

# --- Where your data lives (default: ./data) ---------------------------------------------
# JOBTRACKER_DATA_DIR=~/Documents/Job Search/data

# --- Web server -----------------------------------------------------------------------
# Require a password to open the app (recommended as soon as it is reachable from other devices)
# JOBTRACKER_PASSWORD=
# JOBTRACKER_SESSION_DAYS=30
# JOBTRACKER_HOST=127.0.0.1          # 0.0.0.0 to be reachable from your network (set a password!)
# PORT=8000
# LOG_FORMAT=text                     # json: one JSON object per line (cloud log tools)
# LOG_LEVEL=INFO

# --- Docker compose only ------------------------------------------------------------------
# Folder on your computer for generated CVs when running with Docker (default ./output)
# HOST_OUTPUT_DIR=/Users/you/Library/Mobile Documents/com~apple~CloudDocs/Documents/Job Search/companies
